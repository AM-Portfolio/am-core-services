                    <mxGeometry x="250" y="230" width="400" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="c4" value="&lt;b&gt;Step 4&lt;/b&gt;&lt;br&gt;triggerBootstrapCalculation (debounce 60s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2563EB;fontColor=#fff;align=center;" parent="1" vertex="1">
                    <mxGeometry x="250" y="310" width="400" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="c5" value="&lt;b&gt;Step 5&lt;/b&gt;&lt;br&gt;Kafka: am-trigger-calculation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F59E0B;fontColor=#fff;align=center;" parent="1" vertex="1">
                    <mxGeometry x="250" y="390" width="400" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="c6" value="&lt;b&gt;Step 6&lt;/b&gt;&lt;br&gt;am-portfolio: processCalculation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#64748B;fontColor=#fff;align=center;" parent="1" vertex="1">
                    <mxGeometry x="250" y="470" width="400" height="55" as="geometry"/>
                </mxCell>
