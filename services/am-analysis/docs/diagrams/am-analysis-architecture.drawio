                    <mxGeometry x="250" y="550" width="400" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="c8" value="&lt;b&gt;Step 8&lt;/b&gt;&lt;br&gt;PortfolioEventListener → Mongo save (Flow D)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7C3AED;fontColor=#fff;align=center;" parent="1" vertex="1">
                    <mxGeometry x="250" y="630" width="400" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="c9" value="&lt;b&gt;Step 9&lt;/b&gt;&lt;br&gt;Flow A HTTP portfolio-overviews now returns data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#059669;fontColor=#fff;align=center;" parent="1" vertex="1">
                    <mxGeometry x="250" y="710" width="400" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="cn" value="If Mongo entity exists at step 3: skip 4–8, publish stream directly." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#D1FAE5;strokeColor=#059669;" parent="1" vertex="1">
                    <mxGeometry x="250" y="790" width="400" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="ec1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#334155;strokeWidth=2;endArrow=block;" parent="1" source="c1" target="c2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ec2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#334155;strokeWidth=2;endArrow=block;" parent="1" source="c2" target="c3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ec3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#DC2626;strokeWidth=2;endArrow=block;" parent="1" source="c3" target="c4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ec4" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#334155;strokeWidth=2;endArrow=block;" parent="1" source="c4" target="c5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ec5" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#334155;strokeWidth=2;endArrow=block;" parent="1" source="c5" target="c6" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ec6" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#334155;strokeWidth=2;endArrow=block;" parent="1" source="c6" target="c7" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ec7" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#334155;strokeWidth=2;endArrow=block;" parent="1" source="c7" target="c8" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ec8" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#334155;strokeWidth=2;endArrow=block;" parent="1" source="c8" target="c9" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="flow-d" name="05 Flow D Ingest">
        <mxGraphModel dx="888" dy="95" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1200" background="#ffffff" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="td" value="&lt;b&gt;Flow D — Kafka Ingest to Mongo&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=18;" parent="1" vertex="1">
                    <mxGeometry x="200" y="20" width="500" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="d1" value="&lt;b&gt;Step 1&lt;/b&gt;&lt;br&gt;Kafka topic event arrives" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F59E0B;fontColor=#fff;align=center;" parent="1" vertex="1">
                    <mxGeometry x="250" y="80" width="400" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="d2" value="&lt;b&gt;Step 2&lt;/b&gt;&lt;br&gt;Adapter listener (Portfolio / Market / Trade)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7C3AED;fontColor=#fff;align=center;" parent="1" vertex="1">
                    <mxGeometry x="250" y="170" width="400" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="d3" value="&lt;b&gt;Step 3&lt;/b&gt;&lt;br&gt;Map event → AnalysisEntity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7C3AED;fontColor=#fff;align=center;" parent="1" vertex="1">
                    <mxGeometry x="250" y="260" width="400" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="d4" value="&lt;b&gt;Step 4&lt;/b&gt;&lt;br&gt;AnalysisIngestionService.ingest() → Mongo save" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#059669;fontColor=#fff;align=center;" parent="1" vertex="1">
                    <mxGeometry x="250" y="350" width="400" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="d5" value="&lt;b&gt;Step 5&lt;/b&gt;&lt;br&gt;Spring event → optional portfolio stream if user watching" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2563EB;fontColor=#fff;align=center;" parent="1" vertex="1">
                    <mxGeometry x="250" y="440" width="400" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="topics" value="&lt;b&gt;Topics → Listener&lt;/b&gt;&lt;br&gt;am-portfolio-update → PortfolioEventListener&lt;br&gt;am-stock-price-update → MarketEventListener&lt;br&gt;am-trade-update → TradeEventListener" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fillColor=#EDE9FE;strokeColor=#7C3AED;" parent="1" vertex="1">
                    <mxGeometry x="250" y="530" width="400" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="ed1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#334155;strokeWidth=2;endArrow=block;" parent="1" source="d1" target="d2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ed2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#334155;strokeWidth=2;endArrow=block;" parent="1" source="d2" target="d3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ed3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#334155;strokeWidth=2;endArrow=block;" parent="1" source="d3" target="d4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ed4" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#334155;strokeWidth=2;endArrow=block;" parent="1" source="d4" target="d5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="flow-e" name="06 Flow E Market Tick">
        <mxGraphModel dx="987" dy="106" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="2200" background="#ffffff" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="te" value="&lt;b&gt;Flow E — Stock price update → only subscribed users&lt;/b&gt;&lt;br&gt;Demand-driven: orchestrator reads Redis to know WHO is watching WHAT, then publishes Kafka per userId." style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="80" y="15" width="940" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="pre" value="&lt;b&gt;PREREQUISITE (before any stock tick)&lt;/b&gt;&lt;br&gt;User must already be subscribed via STOMP (Flow B dashboard or portfolio subscribe)." style="swimlane;startSize=30;fillColor=#F0F9FF;strokeColor=#0284C7;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="80" y="85" width="940" height="320" as="geometry"/>
                </mxCell>
                <mxCell id="p1" value="&lt;b&gt;P1&lt;/b&gt; Client STOMP SUBSCRIBE&lt;br&gt;/app/dashboard/subscribe OR portfolio subscribe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4F46E5;fontColor=#fff;align=center;" vertex="1" parent="pre">
                    <mxGeometry x="300" y="45" width="340" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p2" value="&lt;b&gt;P2&lt;/b&gt; Gateway writes Redis Interest Registry&lt;br&gt;interest:registry → { userId → watchTarget }&lt;br&gt;watchTarget = CHANNEL:DASHBOARD_MAIN &lt;i&gt;or&lt;/i&gt; portfolioId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DC2626;fontColor=#fff;align=center;" vertex="1" parent="pre">
                    <mxGeometry x="300" y="115" width="340" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="p3" value="&lt;b&gt;P3&lt;/b&gt; Kafka am-user-watching (SUBSCRIBE)&lt;br&gt;Orchestrator pushes initial snapshot (Flow B)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F59E0B;fontColor=#fff;align=center;" vertex="1" parent="pre">
                    <mxGeometry x="300" y="195" width="340" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p4" value="&lt;b&gt;P4&lt;/b&gt; Client sends HEARTBEAT every ~30s&lt;br&gt;Redis TTL refreshed (35s) — user stays &quot;active&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0284C7;fontColor=#fff;align=center;" vertex="1" parent="pre">
                    <mxGeometry x="300" y="260" width="340" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="pnote" value="If user disconnects / TTL expires → removed from registry → stock ticks skip that user." style="shape=note;whiteSpace=wrap;html=1;size=13;fillColor=#FEE2E2;strokeColor=#DC2626;" vertex="1" parent="pre">
                    <mxGeometry x="40" y="45" width="240" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="ep1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#334155;strokeWidth=2;endArrow=block;" edge="1" parent="pre" source="p1" target="p2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ep2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#334155;strokeWidth=2;endArrow=block;" edge="1" parent="pre" source="p2" target="p3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ep3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#334155;strokeWidth=2;endArrow=block;" edge="1" parent="pre" source="p3" target="p4">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="tick" value="&lt;b&gt;WHEN STOCK PRICE ARRIVES&lt;/b&gt;" style="text;html=1;align=center;fontSize=15;fontStyle=1;fillColor=#FEF3C7;strokeColor=#F59E0B;" vertex="1" parent="1">
                    <mxGeometry x="80" y="430" width="940" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="e0" value="&lt;b&gt;Step 1&lt;/b&gt;&lt;br&gt;Market Data → Kafka am-stock-price-update&lt;br&gt;(batch of symbol → lastPrice ticks)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#64748B;fontColor=#fff;align=center;" parent="1" vertex="1">
                    <mxGeometry x="350" y="480" width="400" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="e0split" value="Step 2&lt;br&gt;Two consumer groups" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;align=center;" parent="1" vertex="1">
                    <mxGeometry x="425" y="560" width="250" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="colL" value="Path A — Background ingest (not user-specific)" style="swimlane;startSize=28;fillColor=#EDE9FE;strokeColor=#7C3AED;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="660" width="420" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="eL3" value="Step 3a MarketEventListener&lt;br&gt;→ Mongo MARKET_INDEX (reference data)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7C3AED;fontColor=#fff;align=center;" parent="colL" vertex="1">
                    <mxGeometry x="30" y="50" width="360" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="eLnote" value="Does NOT push to users directly." style="text;html=1;align=center;fontSize=12;fontColor=#4C1D95;" vertex="1" parent="colL">
                    <mxGeometry x="30" y="120" width="360" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="colR" value="Path B — Live fan-out to subscribed users only" style="swimlane;startSize=28;fillColor=#DBEAFE;strokeColor=#2563EB;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="600" y="660" width="420" height="720" as="geometry"/>
                </mxCell>
                <mxCell id="eR3" value="&lt;b&gt;Step 3b&lt;/b&gt;&lt;br&gt;Orchestrator.onMarketUpdate&lt;br&gt;Parse EquityPriceUpdateEvent → liveTicks map" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2563EB;fontColor=#fff;align=center;" parent="colR" vertex="1">
                    <mxGeometry x="30" y="45" width="360" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="eR4" value="&lt;b&gt;Step 4b&lt;/b&gt;&lt;br&gt;Redis: getAllActiveUserIds()&lt;br&gt;→ Set of userIds currently in interest:registry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DC2626;fontColor=#fff;align=center;" parent="colR" vertex="1">
                    <mxGeometry x="30" y="120" width="360" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="eR5" value="&lt;b&gt;Step 5b&lt;/b&gt;&lt;br&gt;FOR EACH active userId:&lt;br&gt;getWatchedPortfolio(userId) → watchTarget" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2563EB;fontColor=#fff;align=center;" parent="colR" vertex="1">
                    <mxGeometry x="30" y="200" width="360" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="eR6dash" value="&lt;b&gt;Step 6b — Dashboard user&lt;/b&gt;&lt;br&gt;IF watchTarget = CHANNEL:DASHBOARD_MAIN&lt;br&gt;→ overlay liveTicks on Mongo widgets&lt;br&gt;→ Kafka dashboard-*-update (key=userId)&lt;br&gt;→ Gateway → WS /queue/dashboard/*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0284C7;fontColor=#fff;align=center;" vertex="1" parent="colR">
                    <mxGeometry x="30" y="285" width="360" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="eR6port" value="&lt;b&gt;Step 6b — Portfolio user&lt;/b&gt;&lt;br&gt;IF watchTarget = portfolioId (not dashboard)&lt;br&gt;→ load PORTFOLIO entity from Mongo&lt;br&gt;→ overlay liveTicks on holdings&lt;br&gt;→ Kafka am-portfolio-stream (key=userId)&lt;br&gt;→ Gateway → WS /queue/portfolio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0284C7;fontColor=#fff;align=center;" vertex="1" parent="colR">
                    <mxGeometry x="30" y="390" width="360" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="eR7" value="&lt;b&gt;Step 7b&lt;/b&gt;&lt;br&gt;Debounce per user/portfolio&lt;br&gt;Summary 1s | Widgets 5s | Portfolio stream 2s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F59E0B;fontColor=#fff;align=center;" vertex="1" parent="colR">
                    <mxGeometry x="30" y="505" width="360" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="en" value="Portfolio path needs Mongo entity. If missing → entity_not_found, NO bootstrap on tick (use Flow C)." style="shape=note;whiteSpace=wrap;html=1;size=13;fillColor=#FEE2E2;strokeColor=#DC2626;" parent="colR" vertex="1">
                    <mxGeometry x="30" y="580" width="360" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="eRempty" value="If getAllActiveUserIds() is empty → orchestrator logs no_active_watchers and stops. No Kafka publish." style="shape=note;whiteSpace=wrap;html=1;size=13;fillColor=#D1FAE5;strokeColor=#059669;" vertex="1" parent="colR">
                    <mxGeometry x="30" y="645" width="360" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="eeR2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2563EB;strokeWidth=2;endArrow=block;" parent="colR" source="eR3" target="eR4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="eeR3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2563EB;strokeWidth=2;endArrow=block;" parent="colR" source="eR4" target="eR5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="eeR4" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#0284C7;strokeWidth=2;endArrow=block;" parent="colR" source="eR5" target="eR6dash" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="eeR5" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#0284C7;strokeWidth=2;endArrow=block;" edge="1" parent="colR" source="eR5" target="eR6port">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="eeR6" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#F59E0B;strokeWidth=2;endArrow=block;" edge="1" parent="colR" source="eR6dash" target="eR7">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="210" y="380"/>
                            <mxPoint x="210" y="532"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="eeR7" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#F59E0B;strokeWidth=2;endArrow=block;" edge="1" parent="colR" source="eR6port" target="eR7">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="210" y="490"/>
                            <mxPoint x="210" y="532"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="relay" value="&lt;b&gt;Gateway delivery (both paths)&lt;/b&gt;&lt;br&gt;KafkaRelayService consumes widget/portfolio topics.&lt;br&gt;Message key = userId → routes to that user's WebSocket session only." style="swimlane;startSize=28;fillColor=#ECFDF5;strokeColor=#059669;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="80" y="1410" width="940" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="ee0" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#334155;strokeWidth=2;endArrow=block;" parent="1" source="e0" target="e0split" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="eeL" value="3a" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#7C3AED;strokeWidth=2;endArrow=block;" parent="1" source="e0split" target="eL3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="eeR" value="3b" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2563EB;strokeWidth=2;endArrow=block;" parent="1" source="e0split" target="eR3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="darrow" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#94A3B8;strokeWidth=2;endArrow=open;dashed=1;" edge="1" parent="1" source="pre" target="tick">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="darrow2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#059669;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="colR" target="relay">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="kafka-detail" name="07 Kafka Detail">
        <mxGraphModel dx="888" dy="412" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1400" background="#ffffff" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="tk" value="&lt;b&gt;Kafka Consume &amp;amp; Publish Reference&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=18;" parent="1" vertex="1">
                    <mxGeometry x="250" y="20" width="600" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="kin" value="INBOUND (consume)" style="swimlane;startSize=30;fillColor=#FFF7ED;strokeColor=#F59E0B;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="80" width="940" height="520" as="geometry"/>
                </mxCell>
                <mxCell id="r1" value="① am-user-watching → ② DemandDrivenOrchestrator&lt;br&gt;group: am-orchestrator-watching-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBBF24;align=left;spacingLeft=12;fontSize=13;" parent="kin" vertex="1">
                    <mxGeometry x="40" y="50" width="860" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="r2" value="① am-stock-price-update → ②a MarketEventListener (am-analysis-group)&lt;br&gt;① am-stock-price-update → ②b Orchestrator (am-orchestrator-stock-group)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBBF24;align=left;spacingLeft=12;fontSize=13;" parent="kin" vertex="1">
                    <mxGeometry x="40" y="120" width="860" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="r3" value="① am-portfolio-update → ②a PortfolioEventListener → Mongo&lt;br&gt;① am-portfolio-update → ②b DashboardUpdateListener → widgets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBBF24;align=left;spacingLeft=12;fontSize=13;" parent="kin" vertex="1">
                    <mxGeometry x="40" y="200" width="860" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="r4" value="① am-trade-update → ② TradeEventListener → Mongo TRADE entities" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBBF24;align=left;spacingLeft=12;fontSize=13;" parent="kin" vertex="1">
                    <mxGeometry x="40" y="280" width="860" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="r5" value="① am-previous-close-snapshot → ② Redis (previous-close windows)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBBF24;align=left;spacingLeft=12;fontSize=13;" parent="kin" vertex="1">
                    <mxGeometry x="40" y="345" width="860" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="rdup" value="Same topic + different consumer group = both paths run in parallel" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FEF3C7;strokeColor=#F59E0B;" parent="kin" vertex="1">
                    <mxGeometry x="40" y="410" width="860" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="kout" value="OUTBOUND (publish)" style="swimlane;startSize=30;fillColor=#ECFDF5;strokeColor=#059669;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="640" width="940" height="400" as="geometry"/>
                </mxCell>
                <mxCell id="p1" value="① PortfolioStreamingService → ② am-portfolio-stream (key=userId) → Gateway WebSocket" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6EE7B7;align=left;spacingLeft=12;fontSize=13;" parent="kout" vertex="1">
                    <mxGeometry x="40" y="50" width="860" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="p2" value="① DashboardAnalysisService → ② dashboard-summary / activity / allocation / movers / history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6EE7B7;align=left;spacingLeft=12;fontSize=13;" parent="kout" vertex="1">
                    <mxGeometry x="40" y="115" width="860" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="p3" value="① DemandDrivenOrchestrator (bootstrap only) → ② am-trigger-calculation → am-portfolio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6EE7B7;align=left;spacingLeft=12;fontSize=13;dashed=1;" parent="kout" vertex="1">
                    <mxGeometry x="40" y="180" width="860" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="deb" value="&lt;b&gt;Debounce windows&lt;/b&gt;&lt;br&gt;Portfolio stream: 2s | Dashboard summary: 1s | Activity/Movers/Allocation: 5s | Bootstrap: 60s" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fillColor=#E0F2FE;strokeColor=#0284C7;" parent="kout" vertex="1">
