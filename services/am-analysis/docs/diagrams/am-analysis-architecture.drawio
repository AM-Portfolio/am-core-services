                    <mxGeometry x="100" y="20" width="700" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="c1" value="&lt;b&gt;Step 1&lt;/b&gt;&lt;br&gt;Client STOMP subscribe to specific portfolioId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4F46E5;fontColor=#fff;align=center;" parent="1" vertex="1">
