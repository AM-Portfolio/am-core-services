<?xml version="1.0" encoding="UTF-8"?>
<!-- Trigger CI build: restore published dep pins 1.1.3-SNAPSHOT -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.am</groupId>
        <artifactId>am-core-services</artifactId>
        <version>1.1.9-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <groupId>com.am.services</groupId>
    <artifactId>am-analysis</artifactId>
    <version>1.1.9-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>AM Analysis Service</name>
    <description>Centralized Analysis Service</description>

    <properties>
        <!-- Per-artifact published versions (bump independently) -->
        <am.common-lib.version>1.1.5-SNAPSHOT</am.common-lib.version>
        <am.observability-lib.version>1.1.5-SNAPSHOT</am.observability-lib.version>
        <am.kafka-lib.version>1.1.5-SNAPSHOT</am.kafka-lib.version>
        <am.market-domain.version>1.1.5-SNAPSHOT</am.market-domain.version>
        <am.analysis-adapter.version>1.1.5-SNAPSHOT</am.analysis-adapter.version>
        <am.security-lib.version>1.1.5-SNAPSHOT</am.security-lib.version>
        <am.cache-lib.version>1.1.5-SNAPSHOT</am.cache-lib.version>
        <am.feign-lib.version>1.1.5-SNAPSHOT</am.feign-lib.version>
        <am.market-client-lib.version>1.1.5-SNAPSHOT</am.market-client-lib.version>
        <am.trade-client-lib.version>1.1.5-SNAPSHOT</am.trade-client-lib.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Ensures /actuator/prometheus even before a newer am-observability-lib is published -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

             
        <!-- OpenAPI Documentation -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.3.0</version>
        </dependency>

        <!-- Internal Libraries -->
        <dependency>
            <groupId>com.am.libraries</groupId>
            <artifactId>am-common-lib</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.am.libraries</groupId>
            <artifactId>am-observability-lib</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.am.libraries</groupId>
            <artifactId>am-kafka-lib</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.am.domain</groupId>
            <artifactId>am-market-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.am.libraries</groupId>
            <artifactId>am-analysis-adapter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.am.libraries</groupId>
            <artifactId>am-security-lib</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.am.libraries</groupId>
            <artifactId>am-cache-lib</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.am.libraries</groupId>
            <artifactId>am-feign-lib</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Market Data Client Library -->
        <dependency>
            <groupId>com.am.libraries</groupId>
            <artifactId>am-market-client-lib</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.am.libraries</groupId>
            <artifactId>am-trade-client-lib</artifactId>
            <version>${project.version}</version>
        </dependency>
        
        <!-- Feign Client -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>

        <!-- Spring Kafka (orchestrator + dashboard widget publishers) -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Jackson JSR310 -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Resilience4j - Circuit Breaker & Retry -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
            <version>2.1.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Redis - Used by Orchestrator to check InterestRegistry for active watchers -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

