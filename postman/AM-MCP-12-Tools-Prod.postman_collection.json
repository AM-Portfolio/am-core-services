{
  "info": {
    "_postman_id": "am-mcp-12-tools-prod",
    "name": "AM MCP 12 Tools — Prod",
    "description": "All 12 fin-agent MCP read tools on prod.\n\n**Required:** Top-right → select environment **AM MCP Tools — Prod** (NOT 'New Environment').\n`access_token` = JWT only (no 'Bearer ' prefix).\n\nURLs are hardcoded to https://am.asrax.in — works without base_url env var.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const token = (pm.environment.get('access_token') || pm.collectionVariables.get('access_token') || '').replace(/^Bearer\\s+/i, '').trim();",
          "if (token) {",
          "  pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + token });",
          "  pm.collectionVariables.set('access_token', token);",
          "} else if (!pm.request.url.toString().includes('/identity/auth/login') && !pm.request.url.toString().includes('/actuator/health')) {",
          "  pm.request.headers.remove('Authorization');",
          "  console.warn('Select environment AM MCP Tools — Prod and set access_token (JWT only, no Bearer prefix)');",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://am.asrax.in"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "user_id",
      "value": "670116d7-8683-4f35-bdb6-7cf6fb122068"
    },
    {
      "key": "symbol",
      "value": "RELIANCE"
    },
    {
      "key": "portfolio_id",
      "value": ""
    },
    {
      "key": "mcp_session_id",
      "value": "",
      "description": "From GET /mcp/sse id: line — required for folder 99"
    },
    {
      "key": "mcp_rpc_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "00 Setup",
      "item": [
        {
          "name": "Login (saves access_token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const b = pm.response.json();",
                  "  const tok = b.access_token || (b.data && b.data.access_token);",
                  "  if (tok) {",
                  "    const bare = tok.replace(/^Bearer\\s+/i, '').trim();",
                  "    pm.collectionVariables.set('access_token', bare);",
                  "    pm.environment.set('access_token', bare);",
                  "  }",
                  "}",
                  "pm.test('Login 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}"
            },
            "url": "https://am.asrax.in/identity/auth/login"
          }
        },
        {
          "name": "MCP Health (no auth)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "https://am.asrax.in/mcp/actuator/health"
          }
        },
        {
          "name": "Market — available indices (helper)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "https://am.asrax.in/market/v1/indices/available"
          }
        }
      ]
    },
    {
      "name": "01 Portfolio (3 tools)",
      "description": "MCP tools: get_portfolio_summary, get_holdings, get_holding_detail",
      "item": [
        {
          "name": "1. get_portfolio_summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": "https://am.asrax.in/analysis/v1/analysis/dashboard/summary",
            "description": "MCP: `get_portfolio_summary` → am-analysis Mongo holdings book."
          }
        },
        {
          "name": "2. get_holdings (portfolio REST proxy)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "https://am.asrax.in/portfolio/v1/portfolios/holdings?portfolioId={{portfolio_id}}",
            "description": "**MCP `get_holdings`** reads am-analysis Mongo (not this API). Use **99 MCP → get_holdings** for exact MCP behavior. This REST proxy hits am-portfolio holdings."
          }
        },
        {
          "name": "3. get_holding_detail (portfolio REST proxy)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "https://am.asrax.in/portfolio/v1/portfolios/holdings?portfolioId={{portfolio_id}}",
            "description": "MCP: `get_holding_detail` with `symbol={{symbol}}`. Filter response client-side for {{symbol}}, or use **99 MCP → get_holding_detail**."
          }
        }
      ]
    },
